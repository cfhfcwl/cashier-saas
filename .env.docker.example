# Docker 启动用的环境模板
# 用法：cp .env.docker.example .env   然后改掉两个密码
#
# 注意两点：
# 1. 这个文件同时被 docker compose（变量替换）和 ThinkPHP（parse_ini_file）读取，
#    所以【等号两边不要加空格】——带空格的格式 TP 能读，compose 会解析错
# 2. DB_HOST 是 mysql（compose 里的服务名），不是 127.0.0.1

APP_DEBUG=true

DB_TYPE=mysql
DB_HOST=mysql
DB_NAME=cat_lifenews
DB_USER=catlife
DB_PASS=change_me_please
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_PREFIX=cs_

MYSQL_ROOT_PASSWORD=change_me_root

DEFAULT_LANG=zh-cn
